# .env.example — copy to .env.local and fill in your values

# Hosted Postgres (Neon / Supabase / Railway)
# Neon example: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Upstash Redis
# Get from: https://console.upstash.com
REDIS_URL="rediss://default:TOKEN@HOST:PORT"

# Optional: protect the cron endpoint
CRON_SECRET="your-secret-here"
